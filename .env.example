# Environment Configuration Template
# Copy this file to .env and update with your settings (if implementing .env support)

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=inventory_system

# Application Settings
APP_NAME="Inventory Management System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/tradeAssistant

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true

# Timezone
TIMEZONE=UTC

# Security
HASH_ALGO=bcrypt
HASH_COST=10

# Upload Settings
UPLOAD_MAX_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Pagination
ITEMS_PER_PAGE=10

# Low Stock Threshold
LOW_STOCK_MULTIPLIER=1.0

# Email Configuration (for future use)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@inventory.local
MAIL_FROM_NAME="Inventory System"

# API Keys (for future integrations)
# BARCODE_API_KEY=
# SMS_API_KEY=
